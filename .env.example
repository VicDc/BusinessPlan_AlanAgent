# Provider LLM: "local" (LM Studio/Ollama, supportato e testato)
#   claude_fast / claude_quality = SPERIMENTALI, non verificati contro l'API Anthropic reale
LLM_PROVIDER=local
LLM_BASE_URL=http://localhost:1234/v1
LLM_MODEL=gemma-4-26b

# Necessaria solo per LLM_PROVIDER=claude_fast | claude_quality
ANTHROPIC_API_KEY=

SERPER_API_KEY=
OUTPUT_DIR=output
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
MAX_REVISION_CYCLES=3
